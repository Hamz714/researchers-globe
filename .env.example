# Copy to .env and fill in. Never commit .env.

# --- Decision model: Jev (TODO: we don't know its API yet; see reasoning/decision_model.py)
JEV_API_KEY=
JEV_BASE_URL=
# Set JEV_FORMAT=openai and JEV_MODEL only if Jev turns out to be OpenAI-compatible.
JEV_FORMAT=
JEV_MODEL=

# --- Fallback LLM: any OpenAI-compatible /chat/completions endpoint
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_BASE_URL=
FALLBACK_LLM_MODEL=

# --- Live layers
AISSTREAM_API_KEY=

# --- Runtime switches
# 0 = backend serves mock data (default), 1 = backend runs the real pipeline
USE_PIPELINE=0
# 1 = never hit GDELT/Wikipedia, read the cache only (use on stage)
GLOBE_OFFLINE=0
# Wikimedia asks for a descriptive User-Agent with a contact
WIKI_USER_AGENT=ResearchersGlobe/0.1 (HackTheBurgh 2026 student project)
