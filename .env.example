# Copy to .env and fill in. Never commit .env.

# --- Decision model: Jev (TypeSafe), via OpenRouter's Decisions API. See reasoning/decision_model.py.
# One OpenRouter key (https://openrouter.ai/keys, needs credit) works for BOTH Jev and the fallback.
JEV_API_KEY=
JEV_BASE_URL=https://openrouter.ai/api/alpha/decisions
JEV_MODEL=typesafe/jev-1.14
# Alternative provider: JEV_BASE_URL=https://api.aimlapi.com/v1/decisions  JEV_MODEL=typesafe/jev

# --- Fallback LLM (generative; also the only backend for step 1 parsing, since Jev can't write JSON)
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_BASE_URL=https://openrouter.ai/api/v1
FALLBACK_LLM_MODEL=anthropic/claude-haiku-5.5

# --- Live layers (server-side only: AISStream forbids using the key from a browser). Ask Hamzah.
AISSTREAM_API_KEY=

# --- Runtime switches
# 0 = backend serves mock data (default), 1 = backend runs the real pipeline
USE_PIPELINE=0
# 1 = never hit GDELT/Wikipedia, read the cache only (use on stage)
GLOBE_OFFLINE=0
# Wikimedia asks for a descriptive User-Agent with a contact
WIKI_USER_AGENT=ResearchersGlobe/0.1 (HackTheBurgh 2026 student project)
